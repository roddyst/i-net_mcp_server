# Kopieren nach .env oder direkt exportieren.
# Pflicht (außer der Client schickt X-Inet-Base-Url):
INET_BASE_URL=https://helpdesk.example.com:9000

# Authentifizierung: entweder Token ...
INET_TOKEN=dein-access-token
# ... oder Basic Auth:
#INET_USERNAME=servicedesk
#INET_PASSWORD=geheim

# Transport: stdio (Standard), http oder sse
#INET_TRANSPORT=http
#INET_HOST=0.0.0.0
#INET_PORT=8000
#INET_HTTP_PATH=/mcp

# Verhalten
#INET_READ_ONLY=true          # nur lesende Tools anbieten
#INET_TIMEOUT=30              # HTTP-Timeout in Sekunden
#INET_VERIFY_TLS=false        # nur für Testsysteme mit selbstsigniertem Zertifikat
#INET_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt  # CA-Bundle für eine interne CA
#INET_ALLOW_URL_HEADER=true   # X-Inet-Base-Url erlauben, obwohl INET_BASE_URL gesetzt ist
#INET_ALLOW_LOCAL_FILES=false # Anhänge per Dateipfad verbieten
#INET_LOCALE=de               # Standardsprache der Suchphrase
#INET_NORMALIZE=false         # Antworten der Web-API unveraendert durchreichen
#INET_RETRIES=2               # Wiederholungen eines fehlgeschlagenen GET (POST nie)
#INET_POOL_SIZE=8             # gleichzeitig offen gehaltene HelpDesk-Verbindungen

# Leitplanken fuer die schreibenden Tools
#INET_DRY_RUN=true                  # pruefen und zurueckmelden, aber nicht senden
#INET_ALLOWED_ACTIONS=-9,-12        # nur diese Ticketaktionen zulassen
#INET_DENIED_ACTIONS=-2             # diese Ticketaktionen sperren
#INET_DEFAULT_AUTOMAIL=NEVER        # keine Auto-Mails, wenn der Aufruf nichts anderes sagt
