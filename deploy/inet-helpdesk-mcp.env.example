# Nach /etc/inet-helpdesk-mcp/env kopieren.
# Enthaelt Zugangsdaten -> chown root:inet-mcp, chmod 640.
#
#   install -d -m 750 -o root -g inet-mcp /etc/inet-helpdesk-mcp
#   install -m 640 -o root -g inet-mcp deploy/inet-helpdesk-mcp.env.example \
#           /etc/inet-helpdesk-mcp/env
#
# systemd liest die Datei als KEY=VALUE, ohne Shell: keine Anfuehrungszeichen,
# keine Variablen-Expansion, ein Eintrag pro Zeile.

INET_BASE_URL=https://helpdesk.example.com:9000

# Technischer Benutzer (Service-Account) mit dem Recht "Web API".
INET_TOKEN=hier-den-access-token-eintragen

# Alternative statt INET_TOKEN:
#INET_USERNAME=svc-hermes
#INET_PASSWORD=geheim

# Optional
#INET_READ_ONLY=true       # nur lesende Tools anbieten
#INET_TIMEOUT=30
#INET_LOCALE=de
#INET_VERIFY_TLS=false     # nur fuer Testsysteme mit selbstsigniertem Zertifikat

# HelpDesk-Zertifikat aus einer internen CA (Alternative zu INET_VERIFY_TLS=false):
# PEM-Datei der ausstellenden CA, sonst wird nur das certifi-Bundle geprueft.
#INET_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
